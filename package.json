{
  "name": "cesium-workbench",
  "version": "2.0.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Open-source 3D geospatial workbench built with Vue 3, TypeScript and CesiumJS",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tanghaojie/Cesium-Workbench.git"
  },
  "scripts": {
    "dev": "vite --host",
    "vite": "vite --host",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint ."
  },
  "dependencies": {
    "cesium": "1.144.0",
    "element-plus": "2.14.3",
    "fflate": "0.8.3",
    "mediabunny": "1.61.6",
    "vue": "3.5.35",
    "vue-i18n": "11.4.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.19",
    "@vitejs/plugin-vue": "5.2.4",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "fast-glob": "3.3.3",
    "prettier": "3.9.6",
    "sass": "1.102.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "5.4.21",
    "vite-plugin-static-copy": "3.1.4",
    "vite-plugin-svg-icons": "2.0.1",
    "vue-tsc": "2.2.12"
  },
  "homepage": "https://cesium-workbench.github.io/",
  "bugs": {
    "url": "https://github.com/tanghaojie/Cesium-Workbench/issues"
  },
  "keywords": [
    "cesium-workbench",
    "vue3-cesium-typescript-start-up-template",
    "cesium",
    "cesiumjs",
    "vue3",
    "typescript",
    "geospatial",
    "gis",
    "3d-tiles",
    "gltf",
    "geojson",
    "webgl",
    "camera-animation",
    "video-export"
  ]
}
